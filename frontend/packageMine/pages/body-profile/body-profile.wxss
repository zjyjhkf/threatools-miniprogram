.bp {
  min-height: 100vh;
  background: #f1fef9;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.bp-save {
  height: 60rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #00a84a;
  color: #ffffff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}
.bp-save.is-disabled {
  opacity: 0.6;
}
.bp-loading {
  padding: 32rpx;
}
.bp-group {
  margin: 24rpx 32rpx 0;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
}
.bp-block {
  margin: 24rpx 32rpx 0;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 32rpx 32rpx;
}
.bp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.bp-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #101828;
}
.bp-tip {
  font-size: 22rpx;
  color: #98a2b3;
}
.bp-textarea {
  width: 100%;
  height: 132rpx;
  font-size: 28rpx;
  line-height: 44rpx;
  color: #101828;
  background: #f4fffa;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
}
.bp-ph {
  color: #98a2b3;
}
.bp-error {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #ef4444;
}
.bp-note {
  margin: 24rpx 32rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: #98a2b3;
}
