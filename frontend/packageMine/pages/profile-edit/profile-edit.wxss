.pe {
  min-height: 100vh;
  background: #f1fef9;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.pe-save {
  height: 60rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #00a84a;
  color: #ffffff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}
.pe-save.is-disabled {
  opacity: 0.6;
}
.pe-loading {
  padding: 32rpx;
}
.pe-avatar {
  padding: 48rpx 0 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #ffffff;
}
.pe-avatar-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #98a2b3;
}
.pe-group {
  margin: 24rpx 32rpx 0;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
}
.pe-row {
  height: 104rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}
.pe-label {
  font-size: 28rpx;
  color: #344054;
}
.pe-right {
  display: flex;
  align-items: center;
}
.pe-value {
  font-size: 28rpx;
  color: #101828;
  max-width: 400rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.pe-value.is-empty {
  color: #f79009;
}
.pe-arrow {
  width: 28rpx;
  height: 28rpx;
  margin-left: 8rpx;
  color: #98a2b3;
}
.pe-bio {
  padding: 24rpx 32rpx;
}
.pe-bio-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.pe-count {
  font-size: 22rpx;
  color: #98a2b3;
}
.pe-textarea {
  width: 100%;
  height: 140rpx;
  font-size: 28rpx;
  line-height: 44rpx;
  color: #101828;
}
.pe-ph {
  color: #98a2b3;
}
.pe-error {
  font-size: 24rpx;
  color: #ef4444;
}
.pe-tip {
  margin: 24rpx 32rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: #98a2b3;
}
