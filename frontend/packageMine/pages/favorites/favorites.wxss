.fav {
  min-height: 100vh;
  background: #f1fef9;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.fav-tabs {
  height: 88rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  box-sizing: border-box;
}
.fav-tab {
  margin-right: 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  color: #667085;
  position: relative;
}
.fav-tab.is-on {
  color: #00a84a;
  font-weight: 600;
}
.fav-tab.is-on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #00a84a;
}
.fav-body {
  padding: 24rpx 32rpx 0;
}
.fav-item {
  position: relative;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}
.fav-content {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  padding-right: 140rpx;
}
.fav-text {
  font-size: 28rpx;
  line-height: 42rpx;
  color: #344054;
}
.fav-title {
  font-size: 28rpx;
  line-height: 42rpx;
  font-weight: 600;
  color: #101828;
}
.fav-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #98a2b3;
}
.fav-cancel {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #f5fef9;
  color: #667085;
  font-size: 22rpx;
  display: flex;
  align-items: center;
}
.fav-space {
  height: 40rpx;
}
