<view class="fav">
  <nav-bar back title="我的收藏" bind:back="back" />

  <view class="fav-tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="value"
      class="fav-tab {{tab === item.value ? 'is-on' : ''}}"
      data-value="{{item.value}}"
      bindtap="onTab"
    >{{item.label}}</view>
  </view>

  <view wx:if="{{status === 'loading'}}" class="fav-body">
    <skeleton type="card" count="2" />
  </view>

  <empty-state
    wx:elif="{{status === 'error'}}"
    type="error"
    title="网络开小差了"
    btnText="点击重试"
    bind:action="onRetry"
  />

  <empty-state
    wx:elif="{{status === 'empty'}}"
    type="empty"
    title="还没有收藏内容"
    desc="在社区、课程或产品中点击收藏"
    btnText="去逛逛"
    bind:action="goExplore"
  />

  <view wx:else class="fav-body">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="fav-item"
      data-type="{{item.type}}"
      data-id="{{item.id}}"
      bindtap="openItem"
    >
      <block wx:if="{{item.type === 'post'}}">
        <image-ph src="{{item.coverImage}}" w="140" h="140" radius="12rpx" label="" show-text="{{false}}" />
        <view class="fav-content flex-1">
          <text class="fav-text ellipsis-2">{{item.content}}</text>
          <text class="fav-sub">{{item.likeCount}} 次赞</text>
        </view>
      </block>

      <block wx:elif="{{item.type === 'course'}}">
        <image-ph src="{{item.cover}}" w="200" h="120" radius="12rpx" label="" show-text="{{false}}" />
        <view class="fav-content flex-1">
          <text class="fav-title ellipsis-2">{{item.title}}</text>
          <text class="fav-sub">{{item.durText}}</text>
        </view>
      </block>

      <block wx:else>
        <image-ph src="{{item.cover}}" w="140" h="140" radius="12rpx" label="" show-text="{{false}}" />
        <view class="fav-content flex-1">
          <text class="fav-title ellipsis-2">{{item.name}}</text>
          <text class="fav-sub ellipsis-1">{{item.tagline}}</text>
        </view>
      </block>

      <view class="fav-cancel" data-type="{{item.type}}" data-id="{{item.id}}" data-index="{{index}}" catchtap="cancel">
        取消收藏
      </view>
    </view>

    <view class="fav-space"></view>
  </view>

  <toast show="{{toast.show}}" text="{{toast.text}}" />
</view>
