.result {
  min-height: 100vh;
  background: #f1fef9;
}
.result-card {
  margin: 120rpx 32rpx 0;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(16, 24, 40, 0.06);
  padding: 72rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.result-icon {
  width: 160rpx;
  height: 160rpx;
  color: #f59e0b;
}
.result-icon.is-success {
  color: #12b76a;
}
.result-icon.is-fail {
  color: #ef4444;
}
.result-title {
  margin-top: 32rpx;
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: 700;
  color: #101828;
}
.result-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: #667085;
  text-align: center;
}
.result-btn {
  margin-top: 48rpx;
  width: 100%;
  height: 88rpx;
  border-radius: 999rpx;
  background: var(--brand-600);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.result-link {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #667085;
  padding: 16rpx;
}
