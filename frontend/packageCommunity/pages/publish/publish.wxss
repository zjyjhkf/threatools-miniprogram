.publish {
  min-height: 100vh;
  background: #f1fef9;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.pub-submit {
  height: 60rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}
.pub-submit.is-on {
  background: #00a84a;
  color: #ffffff;
}
.pub-submit.is-disabled {
  background: #f5fef9;
  color: #98a2b3;
}
.pub-body {
  padding: 24rpx 32rpx 0;
}
.pub-editor {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
}
.pub-textarea {
  width: 100%;
  height: 240rpx;
  font-size: 28rpx;
  line-height: 44rpx;
  color: #101828;
}
.pub-ph {
  color: #98a2b3;
}
.pub-counter {
  text-align: right;
  font-size: 24rpx;
  color: #98a2b3;
}
.pub-counter.is-limit {
  color: #ef4444;
}
.pub-grid {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.pub-img-item {
  position: relative;
  width: 210rpx;
  height: 210rpx;
}
.pub-img {
  width: 210rpx;
  height: 210rpx;
  border-radius: 16rpx;
  background: #e8f8ef;
}
.pub-img-del {
  position: absolute;
  right: -8rpx;
  top: -8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: rgba(16, 24, 40, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
}
.pub-img-del-icon {
  width: 24rpx;
  height: 24rpx;
  color: #ffffff;
}
.pub-img-add {
  width: 210rpx;
  height: 210rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 2rpx dashed #ddf3e6;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.pub-add-icon {
  width: 48rpx;
  height: 48rpx;
  color: #98a2b3;
}
.pub-add-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #98a2b3;
}
.pub-rows {
  margin-top: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
}
.pub-row {
  height: 104rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f5fef9;
}
.pub-row:last-child {
  border-bottom: none;
}
.pub-row-left {
  display: flex;
  align-items: center;
}
.pub-row-icon {
  width: 40rpx;
  height: 40rpx;
  color: #667085;
  margin-right: 16rpx;
}
.pub-row-label {
  font-size: 28rpx;
  color: #344054;
}
.pub-row-label-disabled {
  color: #98a2b3;
}
.pub-row-right {
  display: flex;
  align-items: center;
}
.pub-row-value {
  font-size: 26rpx;
  color: #98a2b3;
}
.pub-row-value-disabled {
  color: #cdebd9;
}
.pub-row-arrow {
  width: 28rpx;
  height: 28rpx;
  margin-left: 8rpx;
  color: #98a2b3;
}
.pub-topics {
  max-width: 360rpx;
}
.pub-topic-text {
  font-size: 26rpx;
  color: #00a84a;
}
.pub-tip {
  margin-top: 32rpx;
  font-size: 24rpx;
  line-height: 38rpx;
  color: #98a2b3;
  text-align: center;
}
.ts {
  padding: 0 32rpx 32rpx;
}
.ts-selected {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  padding: 16rpx 0;
}
.ts-chip {
  height: 52rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #e8f8ef;
  color: #00a84a;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  margin: 0 12rpx 12rpx 0;
}
.ts-chip-close {
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
}
.ts-count {
  font-size: 22rpx;
  color: #98a2b3;
}
.ts-create {
  display: flex;
  align-items: center;
  height: 88rpx;
  background: #f4fffa;
  border-radius: 16rpx;
  padding: 0 24rpx;
}
.ts-input {
  flex: 1;
  font-size: 26rpx;
  color: #101828;
}
.ts-create-btn {
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #00a84a;
  color: #ffffff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
}
.ts-create-btn.is-disabled {
  opacity: 0.6;
}
.ts-search {
  padding: 24rpx 0 8rpx;
}
.ts-list {
  max-height: 480rpx;
}
.ts-item {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f5fef9;
}
.ts-item.is-disabled {
  opacity: 0.45;
}
.ts-item-name {
  font-size: 28rpx;
  color: #344054;
}
.ts-item-count {
  font-size: 22rpx;
  color: #98a2b3;
}
.ts-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #98a2b3;
}
.vis-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(16, 24, 40, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}
.vis {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}
.vis-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #101828;
  text-align: center;
  margin-bottom: 16rpx;
}
.vis-item {
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: #344054;
  border-bottom: 1rpx solid #f5fef9;
}
.vis-check {
  width: 36rpx;
  height: 36rpx;
  color: #00a84a;
}
