.td {
  min-height: 100vh;
  background: #f1fef9;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
/* 上浮卡片：父级不得 overflow:hidden */
.td-actions {
  position: relative;
  margin: -48rpx 32rpx 0;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(16, 24, 40, 0.06);
  z-index: 2;
}
.td-name {
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: 700;
  color: #101828;
}
.td-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: #667085;
}
.td-stats {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #98a2b3;
}
.td-btns {
  margin-top: 24rpx;
  display: flex;
}
.td-collect {
  flex: 1;
  height: 80rpx;
  border-radius: 999rpx;
  background: #f5fef9;
  color: #344054;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}
.td-collect.is-on {
  background: #e8f8ef;
  color: #00a84a;
}
.td-join {
  flex: 1;
  height: 80rpx;
  border-radius: 999rpx;
  background: var(--brand-600);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.td-sort {
  height: 88rpx;
  margin: 24rpx 32rpx 0;
  display: flex;
  align-items: center;
}
.td-sort-item {
  margin-right: 40rpx;
  font-size: 28rpx;
  color: #667085;
}
.td-sort-item.is-on {
  color: #00a84a;
  font-weight: 600;
}
.td-body {
  padding: 8rpx 32rpx 0;
}
.td-item {
  margin-bottom: 24rpx;
}
.td-bottom-space {
  height: 40rpx;
}
