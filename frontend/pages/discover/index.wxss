page {
  background: var(--bg-page);
}

.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 0 var(--page-pad);
}

.hero {
  margin-top: 20rpx;
  padding: 32rpx;
  border-radius: var(--r-card);
  background: var(--bg-hero);
}

.hero-title {
  font-size: 40rpx;
  line-height: 54rpx;
  font-weight: 700;
  color: var(--ink-900);
}

.hero-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--ink-500);
}

.guides {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.guide {
  flex: 1;
  padding: 22rpx 18rpx;
  border-radius: var(--r-card);
  background: var(--bg-card);
  border: 1rpx solid var(--line-200);
  box-shadow: var(--sh-soft);
}

.guide-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: var(--brand-100);
  display: flex;
  align-items: center;
  justify-content: center;
}

.guide-icon .icon {
  font-size: 34rpx;
  color: var(--brand-600);
}

.guide-title {
  margin-top: 16rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: var(--ink-900);
}

.guide-sub {
  margin-top: 2rpx;
  font-size: 19rpx;
  color: var(--ink-400);
}

.tabs {
  display: flex;
  align-items: center;
  gap: 36rpx;
  margin-top: 32rpx;
  border-bottom: 1rpx solid var(--line-200);
}

.tab {
  position: relative;
  padding-bottom: 16rpx;
  font-size: 28rpx;
  color: var(--ink-500);
  font-weight: 500;
}

.tab.is-on {
  color: var(--ink-900);
  font-weight: 700;
}

.tab-line {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 48rpx;
  height: 6rpx;
  margin-left: -24rpx;
  border-radius: 999rpx;
  background: var(--brand-600);
}

.tab-link {
  margin-left: auto;
  padding-bottom: 16rpx;
  font-size: 22rpx;
  color: var(--brand-700);
  font-weight: 600;
}

.state {
  padding: 80rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-400);
}

.state-text {
  font-size: 24rpx;
  color: var(--ink-500);
}

.state-btn {
  display: inline-flex;
  margin-top: 20rpx;
  height: 68rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: var(--brand-600);
  color: #fff;
  font-size: 23rpx;
  align-items: center;
}

.post {
  display: flex;
  gap: 20rpx;
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: var(--r-card);
  background: var(--bg-card);
  border: 1rpx solid var(--line-200);
}

.post-cover {
  width: 200rpx;
  height: 150rpx;
  border-radius: 20rpx;
  background: var(--bg-skeleton);
  flex: none;
}

.post-cover.ph {
  display: flex;
  align-items: center;
  justify-content: center;
}

.post-cover.ph .icon {
  font-size: 46rpx;
  color: var(--brand-300);
}

.post-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.post-title {
  font-size: 27rpx;
  line-height: 40rpx;
  font-weight: 600;
  color: var(--ink-900);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.post-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.post-author {
  font-size: 21rpx;
  color: var(--ink-400);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-like {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 21rpx;
  color: var(--ink-400);
}

.post-like .icon {
  font-size: 24rpx;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 18rpx;
}

.tab-space {
  height: calc(112rpx + 40rpx + env(safe-area-inset-bottom));
}
