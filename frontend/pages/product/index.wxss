page {
  height: 100%;
  overflow: hidden;
}

.prod {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: var(--bg-page);
}

/* 顶部 产品 / 课程：选中黑字 + 绿色短下划线 */
.prod-tabs {
  flex: none;
  height: 96rpx;
  display: flex;
  align-items: stretch;
  background: var(--bg-page);
}
.prod-tab {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-bottom: 12rpx;
  box-sizing: border-box;
}
.prod-tab-text {
  font-size: 30rpx;
  line-height: 42rpx;
  color: var(--ink-500);
  font-weight: 400;
}
.prod-tab.is-on .prod-tab-text {
  font-size: 32rpx;
  color: var(--ink-900);
  font-weight: 700;
}
.prod-tab-line {
  position: absolute;
  left: 50%;
  bottom: 4rpx;
  width: 48rpx;
  height: 6rpx;
  margin-left: -24rpx;
  border-radius: 3rpx;
  background: var(--brand-600);
}

.prod-body {
  flex: 1;
  min-height: 0;
  position: relative;
}
.prod-swiper {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}
