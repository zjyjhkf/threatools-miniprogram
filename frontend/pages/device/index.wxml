<view class="page">
  <view class="status-bar" style="height:{{statusBarHeight}}px"></view>

  <view class="brand">
    <view class="brand-main">
      <view class="brand-name">Theratools</view>
      <view class="brand-sub">智能康复生态</view>
      <view class="brand-line"></view>
    </view>
    <view class="brand-actions">
      <view class="icon-btn" bindtap="onNotice">
        <text class="icon icon-bell"></text>
      </view>
      <view class="capsule-space"></view>
    </view>
  </view>

  <view class="hero">
    <view class="hero-copy">
      <view class="hero-title">我的智能设备</view>
      <view class="hero-sub">配对设备、查看状态与调节参数</view>
      <view class="hero-btn" bindtap="onAdd"><text class="icon icon-bluetooth"></text>连接设备 <text class="cta-arrow">›</text></view>
    </view>
    <image class="hero-img" src="/assets/hero-community.jpg" mode="aspectFill" />
  </view>

  <view class="sec-head">
    <view class="sec-title">我的设备</view>
    <view class="sec-sub" wx:if="{{hasDevice}}">{{connectedCount}} 台已连接</view>
  </view>

  <view class="dev-grid" wx:if="{{hasDevice}}">
    <view
      class="dev-card {{item.connected ? 'is-on' : ''}}"
      wx:for="{{devices}}"
      wx:key="deviceId"
      data-id="{{item.deviceId}}"
      bindtap="onDeviceTap"
      bindlongpress="onDeviceLongPress"
    >
      <view class="dev-top">
        <view class="dev-icon"><text class="icon icon-{{item.icon}}"></text></view>
        <view class="dev-state {{item.stateClass}}"><view class="state-dot"></view>{{item.stateText}}</view>
      </view>
      <view class="dev-name">{{item.alias}}</view>
      <view class="dev-model">{{item.modelText}}</view>
      <view class="dev-meta" wx:if="{{item.batteryText}}">{{item.batteryText}}</view>
      <view class="dev-cta">{{item.cta}}<text class="cta-arrow">›</text></view>
    </view>

    <view class="dev-card add-card" bindtap="onAdd">
      <view class="add-icon"><text class="icon icon-plus"></text></view>
      <view class="add-title">添加设备</view>
      <view class="add-sub">连接更多康复设备</view>
    </view>
  </view>

  <view class="empty-card" wx:else bindtap="onAdd">
    <view class="empty-icon"><text class="icon icon-bluetooth"></text></view>
    <view class="empty-title">连接你的第一台设备</view>
    <view class="empty-sub">支持空气压力波、筋膜枪、电动泡沫轴</view>
    <view class="empty-btn">选择设备类型 <text class="cta-arrow">›</text></view>
  </view>

  <view class="sec-head">
    <view class="sec-title">快捷场景</view>
  </view>

  <view class="quick-row">
    <view class="quick" bindtap="onQuickControl">
      <text class="icon icon-zap quick-icon"></text>
      <view class="quick-text">设备控制</view>
    </view>
    <view class="quick" bindtap="onCourse">
      <text class="icon icon-run quick-icon"></text>
      <view class="quick-text">康复课程</view>
    </view>
    <view class="quick" bindtap="onCommunity">
      <text class="icon icon-user quick-icon"></text>
      <view class="quick-text">运动社区</view>
    </view>
  </view>

  <view class="recent" wx:if="{{last}}" bindtap="onRecentTap">
    <view class="recent-icon"><text class="icon icon-clock"></text></view>
    <view class="recent-body">
      <view class="recent-title">最近使用</view>
      <view class="recent-sub">{{last.alias}} · {{last.timeText}}</view>
    </view>
    <view class="recent-action">{{last.actionText}}<text class="cta-arrow">›</text></view>
  </view>

  <view class="sec-head">
    <view class="sec-title">社区与内容</view>
  </view>

  <view class="link-card">
    <view class="link-row" bindtap="onCommunity">
      <view class="link-icon"><text class="icon icon-heart"></text></view>
      <view class="link-body">
        <view class="link-title">运动社区</view>
        <view class="link-sub">训练日常与作品分享</view>
      </view>
      <text class="link-arrow">›</text>
    </view>
    <view class="link-row" bindtap="onCourse">
      <view class="link-icon"><text class="icon icon-run"></text></view>
      <view class="link-body">
        <view class="link-title">康复课程</view>
        <view class="link-sub">按部位与目标选择训练</view>
      </view>
      <text class="link-arrow">›</text>
    </view>
    <view class="link-row" bindtap="onProduct">
      <view class="link-icon"><text class="icon icon-box"></text></view>
      <view class="link-body">
        <view class="link-title">康复产品</view>
        <view class="link-sub">设备与配件了解</view>
      </view>
      <text class="link-arrow">›</text>
    </view>
  </view>

  <view class="tab-space"></view>
</view>
