<view class="home">
  <view class="home-nav" style="padding-top: {{statusBarHeight}}px">
    <view class="home-nav-inner">
      <view class="brand">
        <text class="brand-title">健衡运动社区</text>
        <text class="brand-sub">运动康复生态</text>
        <view class="brand-line"></view>
      </view>
      <view class="brand-bell" bindtap="onNotice">
        <view class="icon icon-bell brand-bell-icon"></view>
      </view>
    </view>
  </view>

  <offline-bar />

  <scroll-view
    class="home-scroll"
    scroll-y
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onPullRefresh"
  >
    <!-- 运动社区主视觉（浅绿卡，不是品牌绿） -->
    <view class="hero">
      <view class="hero-copy">
        <view class="hero-eyebrow">
          <view class="hero-dot"></view>
          <text>运动社区</text>
        </view>
        <text class="hero-title hero-title-first">记录每一次坚持</text>
        <text class="hero-title">遇见更好的自己</text>
        <text class="hero-desc">分享训练日常，和同路人一起变好</text>
        <view class="hero-actions">
          <view class="hero-btn" bindtap="goCommunity">进入社区</view>
          <view class="hero-link" bindtap="goPublish">发布作品</view>
        </view>
      </view>
      <image class="hero-img" src="/assets/hero-community.jpg" mode="aspectFill" lazy-load />
      <view class="hero-fade"></view>
    </view>

    <!-- 运动社区模块 -->
    <view class="community-card">
      <view class="sec-head">
        <view class="sec-title-wrap">
          <text class="sec-title">运动社区</text>
          <view class="sec-line"></view>
        </view>
        <text class="sec-action" bindtap="goPublish">发布作品 +</text>
      </view>

      <view class="seg">
        <view class="seg-item {{feedTab === 0 ? 'is-on' : ''}}" data-index="0" bindtap="onFeedTab">推荐</view>
        <view class="seg-item {{feedTab === 1 ? 'is-on' : ''}}" data-index="1" bindtap="onFeedTab">我的作品</view>
      </view>

      <block wx:if="{{feedTab === 0}}">
        <view wx:if="{{recommendStatus === 'loading'}}" class="feed-grid">
          <view class="feed-col">
            <skeleton type="card" count="1" />
          </view>
          <view class="feed-col">
            <skeleton type="card" count="1" />
          </view>
          <view class="feed-col">
            <skeleton type="card" count="1" />
          </view>
        </view>

        <view wx:elif="{{recommendStatus === 'error'}}" class="home-warn" bindtap="retryRecommend">
          网络开小差了，点击重试
        </view>

        <view wx:elif="{{recommendStatus === 'empty'}}" class="home-empty">
          <view class="home-empty-icon icon icon-run"></view>
          <text class="home-empty-text">还没有作品，成为第一个分享的人</text>
        </view>

        <view wx:else class="feed-grid">
          <view
            class="feed-item"
            wx:for="{{recommend}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="openPost"
          >
            <view class="feed-cover">
              <image
                wx:if="{{item.cover.url}}"
                class="feed-cover-img"
                src="{{item.cover.url}}"
                mode="aspectFill"
                lazy-load
              />
              <view wx:else class="feed-cover-ph">
                <view class="icon icon-image feed-cover-icon"></view>
              </view>
            </view>
            <text class="feed-title">{{item.displayTitle}}</text>
            <view class="feed-author">
              <view class="feed-avatar">
                <image wx:if="{{item.author.avatar}}" class="feed-avatar-img" src="{{item.author.avatar}}" mode="aspectFill" />
                <view wx:else class="icon icon-user feed-avatar-icon"></view>
              </view>
              <text class="feed-name">{{item.author.nickname}}</text>
              <view class="feed-like">
                <view class="icon icon-heart feed-like-icon"></view>
                <text class="feed-like-count">{{item.likeText}}</text>
              </view>
            </view>
          </view>
        </view>
      </block>

      <block wx:else>
        <view wx:if="{{worksStatus === 'guest'}}" class="home-empty">
          <view class="home-empty-icon icon icon-user"></view>
          <text class="home-empty-text">登录后查看我的作品</text>
          <view class="home-empty-btn" bindtap="goLogin">微信一键登录</view>
        </view>

        <view wx:elif="{{worksStatus === 'loading'}}" class="feed-grid">
          <view class="feed-col">
            <skeleton type="card" count="1" />
          </view>
          <view class="feed-col">
            <skeleton type="card" count="1" />
          </view>
        </view>

        <view wx:elif="{{worksStatus === 'error'}}" class="home-warn" bindtap="retryWorks">
          加载失败，点击重试
        </view>
        
        <view wx:elif="{{worksStatus === 'empty'}}" class="home-empty">
          <view class="home-empty-icon icon icon-image"></view>
          <text class="home-empty-text">还没有作品</text>
          <text class="home-empty-desc">记录你的第一次训练与分享</text>
          <view class="home-empty-btn" bindtap="goPublish">发布第一个作品</view>
        </view>
        
        <block wx:else>
          <view class="works-stats">
            <text class="works-stats-strong">{{worksTotal}}</text>
            <text class="works-stats-label">作品</text>
            <view class="works-stats-line"></view>
            <text class="works-stats-strong">{{worksLikes}}</text>
            <text class="works-stats-label">获赞</text>
          </view>
          <view class="works-grid">
            <view
              class="works-item"
              wx:for="{{works}}"
              wx:key="id"
              data-id="{{item.id}}"
              bindtap="openWork"
            >
              <work-card item="{{item}}" show-status="{{true}}" />
            </view>
          </view>
        </block>
      </block>

      <view class="card-more" bindtap="onMore">查看全部作品 ›</view>
    </view>

    <!-- 快捷场景 -->
    <view class="quick-block">
      <view class="sec-head sec-head-out">
        <view class="sec-title-wrap">
          <text class="sec-title">快捷场景</text>
          <view class="sec-line"></view>
        </view>
      </view>
      <view class="quick-row">
        <view class="quick-card" data-tab="course" bindtap="goProduct">
          <view class="icon icon-play quick-icon"></view>
          <text class="quick-text">康复课程</text>
          <view class="icon icon-arrow quick-arrow"></view>
        </view>
        <view class="quick-card" data-tab="product" bindtap="goProduct">
          <view class="icon icon-box quick-icon"></view>
          <text class="quick-text">康复产品</text>
          <view class="icon icon-arrow quick-arrow"></view>
        </view>
        <view class="quick-card" bindtap="goMyWorks">
          <view class="icon icon-image quick-icon"></view>
          <text class="quick-text">我的发布</text>
          <view class="icon icon-arrow quick-arrow"></view>
        </view>
      </view>
    </view>

    <!-- 精选推荐 -->
    <view class="featured-block">
      <view class="sec-head">
        <view class="sec-title-wrap">
          <text class="sec-title">精选推荐</text>
          <view class="sec-line"></view>
        </view>
        <text class="sec-action" bindtap="goProduct">查看全部 ›</text>
      </view>

      <view wx:if="{{featured.product}}" class="feat-card" data-id="{{featured.product.id}}" bindtap="openProduct">
        <image-ph class="feat-img" src="{{featured.product.cover}}" w="140" h="140" radius="20rpx" show-text="{{false}}" />
        <view class="feat-body flex-1">
          <text class="feat-title">{{featured.product.name}}</text>
          <text class="feat-desc">{{featured.product.tagline}}</text>
          <text class="feat-link">查看详情</text>
        </view>
      </view>

      <view wx:if="{{featured.course}}" class="feat-card" data-id="{{featured.course.id}}" bindtap="openCourse">
        <image-ph class="feat-img" src="{{featured.course.cover}}" w="140" h="140" radius="20rpx" show-text="{{false}}" />
        <view class="feat-body flex-1">
          <text class="feat-title">{{featured.course.title}}</text>
          <text class="feat-desc">{{featured.courseMeta}}</text>
          <text class="feat-link">去训练</text>
        </view>
      </view>

      <view wx:if="{{featuredStatus === 'empty'}}" class="home-empty home-empty-plain">
        <text class="home-empty-text">精选内容准备中</text>
      </view>
    </view>

    <view class="home-bottom-space"></view>
  </scroll-view>

  <toast show="{{toast.show}}" text="{{toast.text}}" />
</view>
