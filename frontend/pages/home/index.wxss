/* H01 首页：浅绿底 + 白卡 + 小面积绿（07 §3） */
page {
  height: 100%;
}

.home {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, var(--bg-page-top) 0%, var(--bg-page) 45%, var(--brand-50) 100%);
}

/* ---------- 顶部品牌栏（右上角留胶囊安全区） ---------- */
.home-nav {
  flex: none;
}
.home-nav-inner {
  height: 88rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.brand {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.brand-title {
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 700;
  color: var(--ink-900);
}
.brand-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--ink-500);
}
.brand-line {
  margin-top: 8rpx;
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--brand-600);
}
/* 微信胶囊区 176×64：按钮靠左放置，避免落入胶囊区域 */
.brand-bell {
  width: 88rpx;
  height: 88rpx;
  margin-right: 176rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.brand-bell-icon {
  width: 68rpx;
  height: 68rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border-radius: 50%;
  background: var(--bg-card);
  border: 1rpx solid var(--line-200);
  color: var(--brand-600);
}

.home-scroll {
  flex: 1;
  height: 0;
}

/* ---------- 运动社区主视觉 ---------- */
.hero {
  position: relative;
  height: 300rpx;
  margin: 16rpx 32rpx 0;
  border-radius: var(--r-card);
  overflow: hidden;
  background: linear-gradient(135deg, #e1fcee 0%, var(--bg-hero) 55%, #f7fffb 100%);
}
.hero-copy {
  position: absolute;
  left: 32rpx;
  top: 26rpx;
  right: 300rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
}
.hero-eyebrow {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
  color: var(--brand-700);
}
.hero-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--brand-600);
}
.hero-title {
  font-size: 40rpx;
  line-height: 52rpx;
  font-weight: 700;
  color: var(--ink-900);
}
.hero-title-first {
  margin-top: 8rpx;
}
.hero-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--ink-500);
}
.hero-actions {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
}
.hero-btn {
  width: 184rpx;
  height: 64rpx;
  border-radius: var(--r-full);
  background: var(--brand-600);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hero-btn:active {
  background: var(--brand-700);
}
.hero-link {
  margin-left: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand-700);
  padding: 16rpx 8rpx;
}
.hero-img {
  position: absolute;
  top: 0;
  right: 0;
  width: 42%;
  height: 100%;
}
.hero-fade {
  position: absolute;
  top: 0;
  left: 0;
  width: 62%;
  height: 100%;
  background: linear-gradient(90deg, #e3fcef 0%, rgba(227, 252, 239, 0.92) 70%, rgba(227, 252, 239, 0) 100%);
}

/* ---------- 区块标题 ---------- */
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sec-title-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.sec-title {
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 700;
  color: var(--ink-900);
}
.sec-line {
  width: 56rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--brand-600);
}
.sec-action {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand-700);
  padding: 16rpx 0;
}

/* ---------- 运动社区模块（白卡） ---------- */
.community-card {
  margin: 20rpx 32rpx 0;
  padding: 20rpx;
  border-radius: var(--r-card);
  background: var(--bg-card);
  box-shadow: var(--sh-card);
}
.seg {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 40rpx;
}
.seg-item {
  position: relative;
  font-size: 26rpx;
  line-height: 36rpx;
  color: var(--ink-500);
  padding-bottom: 12rpx;
}
.seg-item.is-on {
  font-weight: 700;
  color: var(--ink-900);
}
.seg-item.is-on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 40rpx;
  height: 6rpx;
  margin-left: -20rpx;
  border-radius: 3rpx;
  background: var(--brand-600);
}

.feed-grid,
.works-grid {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
/* 推荐流：3 列紧凑卡，一行放下，避免整块过高 */
.feed-item {
  width: calc(33.333% - 8rpx);
  display: flex;
  flex-direction: column;
}
.feed-col {
  width: calc(33.333% - 8rpx);
}
.feed-cover {
  width: 100%;
  height: 150rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--brand-100);
}
.feed-cover-img {
  width: 100%;
  height: 100%;
  display: block;
}
.feed-cover-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.feed-cover-icon {
  width: 44rpx;
  height: 44rpx;
  color: var(--brand-600);
  opacity: 0.5;
}
.feed-title {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
  color: var(--ink-900);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}
.feed-author {
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.feed-avatar {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--brand-100);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.feed-avatar-img {
  width: 100%;
  height: 100%;
}
.feed-avatar-icon {
  width: 16rpx;
  height: 16rpx;
  color: var(--brand-700);
}
.feed-name {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  line-height: 26rpx;
  color: var(--ink-500);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* 三列卡片宽度有限，点赞数放在详情页展示，首页只保留最必要信息 */
.feed-like {
  display: none;
}

.works-stats {
  margin-top: 20rpx;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.works-stats-strong {
  font-size: 36rpx;
  line-height: 44rpx;
  font-weight: 700;
  color: var(--ink-900);
}
.works-stats-label {
  font-size: 22rpx;
  color: var(--ink-500);
}
.works-stats-line {
  width: 1rpx;
  height: 24rpx;
  margin: 0 16rpx;
  background: var(--line-200);
}
.works-item {
  width: calc(50% - 6rpx);
}

.card-more {
  margin-top: 12rpx;
  padding-top: 12rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--brand-700);
}

/* ---------- 空态 / 错误 ---------- */
.home-empty {
  margin-top: 24rpx;
  padding: 40rpx 24rpx;
  border-radius: var(--r-m);
  background: var(--bg-soft);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.home-empty-plain {
  background: transparent;
}
.home-empty-icon {
  width: 88rpx;
  height: 88rpx;
  color: var(--brand-600);
  opacity: 0.45;
}
.home-empty-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 36rpx;
  color: var(--ink-700);
}
.home-empty-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--ink-500);
}
.home-empty-btn {
  margin-top: 20rpx;
  height: 72rpx;
  padding: 0 40rpx;
  border-radius: var(--r-full);
  background: var(--brand-600);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.home-warn {
  margin-top: 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: var(--r-s);
  background: var(--bg-warn);
  color: var(--ink-warn);
  font-size: 24rpx;
}

/* ---------- 快捷场景 ---------- */
.quick-block {
  margin-top: 40rpx;
  padding: 0 32rpx;
}
.quick-row {
  margin-top: 20rpx;
  display: flex;
  gap: 16rpx;
}
.quick-card {
  position: relative;
  flex: 1;
  height: 120rpx;
  padding: 20rpx;
  border-radius: var(--r-m);
  background: var(--bg-soft);
  border: 1rpx solid var(--line-200);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.quick-icon {
  width: 40rpx;
  height: 40rpx;
  color: var(--brand-600);
}
.quick-text {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
  color: var(--ink-900);
}
.quick-arrow {
  position: absolute;
  right: 12rpx;
  bottom: 18rpx;
  width: 22rpx;
  height: 22rpx;
  color: var(--ink-400);
}

/* ---------- 精选推荐 ---------- */
.featured-block {
  margin-top: 40rpx;
  padding: 0 32rpx;
}
.feat-card {
  margin-top: 20rpx;
  padding: 16rpx;
  border-radius: var(--r-m);
  background: var(--bg-card);
  box-shadow: var(--sh-card);
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.feat-img {
  width: 140rpx;
  height: 140rpx;
  flex: none;
}
.feat-body {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.feat-title {
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 700;
  color: var(--ink-900);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.feat-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--ink-500);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.feat-link {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
  color: var(--brand-700);
}

.home-bottom-space {
  height: calc(112rpx + 40rpx + env(safe-area-inset-bottom));
}
