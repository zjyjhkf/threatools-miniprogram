<view class="page">
  <nav-bar title="{{title}}" back transparent bind:back="onBack" />

  <block wx:if="{{isDetail}}">
    <view class="hero">
      <view class="hero-icon"><text class="icon icon-{{model.icon}}"></text></view>
      <view class="hero-name">{{model.name}}</view>
      <view class="hero-tagline">{{model.tagline}}</view>
      <view class="hero-badges">
        <view class="badge">BLE 5.0</view>
        <view class="badge">{{model.scene}}</view>
      </view>
    </view>

    <view class="card">
      <view class="card-title">设备介绍</view>
      <view class="para">{{model.intro}}</view>
    </view>

    <view class="card">
      <view class="card-title">能做什么</view>
      <view class="feature" wx:for="{{model.features}}" wx:key="*this">
        <text class="icon icon-check feature-icon"></text>
        <view class="feature-text">{{item}}</view>
      </view>
    </view>

    <view class="card">
      <view class="card-title">设备参数</view>
      <view class="spec" wx:for="{{model.specs}}" wx:key="k">
        <view class="spec-k">{{item.k}}</view>
        <view class="spec-v">{{item.v}}</view>
      </view>
    </view>

    <view class="card">
      <view class="card-title">使用前请注意</view>
      <view class="safety" wx:for="{{model.safety}}" wx:key="*this">
        <view class="safety-dot"></view>
        <view class="safety-text">{{item}}</view>
      </view>
    </view>

    <view class="bottom-space"></view>
    <view class="bottom-bar">
      <view class="primary-btn" bindtap="onStartConnect">开始连接设备 <text>›</text></view>
    </view>
  </block>

  <block wx:else>
    <view class="choose-head">
      <view class="choose-title">选择设备类型</view>
      <view class="choose-sub">选择与你手中的设备相符的型号</view>
    </view>

    <view class="model-list">
      <view class="model-card" wx:for="{{models}}" wx:key="key" data-key="{{item.key}}" bindtap="onModelTap">
        <view class="model-icon"><text class="icon icon-{{item.icon}}"></text></view>
        <view class="model-body">
          <view class="model-name">{{item.name}}</view>
          <view class="model-tagline">{{item.tagline}}</view>
          <view class="model-scene">{{item.scene}}</view>
        </view>
        <text class="model-arrow">›</text>
      </view>
    </view>

    <view class="tip-card">
      <text class="icon icon-bluetooth tip-icon"></text>
      <view class="tip-text">连接前开启手机蓝牙，并让设备进入配对模式。</view>
    </view>
    <view class="bottom-space"></view>
  </block>
</view>
