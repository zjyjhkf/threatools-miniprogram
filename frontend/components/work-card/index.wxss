/* 我的作品卡（白底、浅阴影、不整卡绿） */
.work {
  display: flex;
  flex-direction: column;
  background: var(--bg-card);
  border-radius: var(--r-m);
  box-shadow: var(--sh-soft);
  overflow: hidden;
}

.work-cover {
  position: relative;
  width: 100%;
  height: 311rpx;
  background: var(--brand-100);
  overflow: hidden;
}

.work-cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.work-cover-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.work-cover-icon {
  width: 56rpx;
  height: 56rpx;
  color: var(--brand-600);
  opacity: 0.5;
}

.work-status {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: var(--r-full);
  font-size: 20rpx;
  line-height: 40rpx;
}

.work-status.is-published {
  background: var(--brand-100);
  color: var(--brand-700);
}

.work-status.is-hidden {
  background: var(--bg-danger-soft);
  color: var(--danger-600);
}

.work-info {
  padding: 16rpx 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.work-title {
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 600;
  color: var(--ink-900);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.work-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.work-date {
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--ink-400);
}

.work-like {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.work-like-icon {
  width: 22rpx;
  height: 22rpx;
  color: var(--ink-400);
}

.work-like-count {
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--ink-400);
}
