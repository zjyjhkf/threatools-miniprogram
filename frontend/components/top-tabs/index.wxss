.tabs {
  height: 96rpx;
  display: flex;
  background: #ffffff;
  position: relative;
}
.tabs-item {
  flex: 1;
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}
.tabs-text {
  font-size: 30rpx;
  line-height: 42rpx;
  color: #667085;
}
.tabs-item.is-on .tabs-text {
  color: #00a84a;
  font-weight: 600;
}
.tabs-line {
  position: absolute;
  bottom: 8rpx;
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #00a84a;
}
