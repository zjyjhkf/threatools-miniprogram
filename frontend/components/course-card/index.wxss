:host {
  display: block;
}
.cc-row {
  display: flex;
  padding: 16rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-sizing: border-box;
}
.cc-body {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 174rpx;
  padding: 4rpx 0;
  box-sizing: border-box;
}
.cc-title {
  font-size: 30rpx;
  line-height: 42rpx;
  font-weight: 600;
  color: #101828;
}
.cc-sub {
  font-size: 24rpx;
  line-height: 34rpx;
  color: #98a2b3;
}
.cc-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.cc-coach {
  font-size: 24rpx;
  color: #667085;
}
.cc-learn {
  font-size: 24rpx;
  color: #98a2b3;
}
.cc-col {
  display: flex;
  flex-direction: column;
}
.cc-hero {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
}
.cc-hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 32rpx;
  background: linear-gradient(180deg, rgba(16, 24, 40, 0) 0%, rgba(16, 24, 40, 0.62) 100%);
  display: flex;
  flex-direction: column;
}
.cc-hero-tag {
  align-self: flex-start;
  font-size: 20rpx;
  color: #ffffff;
  background: rgba(0, 168, 74, 0.9);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-bottom: 12rpx;
}
.cc-hero-title {
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: 700;
  color: #ffffff;
}
.cc-hero-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}
