/* C23 FeedTile（05 §4.7）：透明底、无边框、无内阴影 */
.tile {
  width: 343rpx;
  display: flex;
  flex-direction: column;
  background: transparent;
}

.tile-cover {
  width: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--brand-100, #e8f8ef);
}

.tile-cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.tile-cover-ph {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tile-cover-icon {
  width: 44rpx;
  height: 44rpx;
  color: var(--brand-600, #00a84a);
  opacity: 0.55;
}

.tile-cover-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--brand-600, #00a84a);
}

.tile-info {
  padding: 12rpx 8rpx 8rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tile-title-row {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.tile-title-icon {
  width: 26rpx;
  height: 26rpx;
  flex: none;
  padding-top: 4rpx;
  box-sizing: content-box;
  color: var(--ink-900, #101828);
}

.tile-title {
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 600;
  color: var(--ink-900, #101828);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.tile-stat {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.tile-stat-icon {
  width: 22rpx;
  height: 22rpx;
  flex: none;
  color: var(--success-600, #12b76a);
}

.tile-stat-text {
  font-size: 24rpx;
  line-height: 32rpx;
  color: var(--ink-500, #667085);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tile-author {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tile-avatar {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #c9f0d9;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tile-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.tile-avatar-icon {
  width: 18rpx;
  height: 18rpx;
  color: #008c3e;
}

.tile-name {
  font-size: 24rpx;
  line-height: 32rpx;
  color: var(--ink-500, #667085);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tile-like {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex: none;
}

.tile-like-icon {
  width: 26rpx;
  height: 26rpx;
  color: var(--ink-400, #98a2b3);
}

.tile-like-count {
  font-size: 24rpx;
  line-height: 32rpx;
  color: var(--ink-400, #98a2b3);
}

.is-liked .tile-like-icon,
.is-liked .tile-like-count {
  color: var(--success-600, #12b76a);
}
