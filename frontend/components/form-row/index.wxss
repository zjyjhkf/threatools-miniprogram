.fr-wrap {
  background: #ffffff;
}
.fr {
  min-height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  box-sizing: border-box;
}
.fr.is-error {
  border: 2rpx solid #ef4444;
  border-radius: 16rpx;
}
.fr-label {
  width: 200rpx;
  font-size: 28rpx;
  color: #344054;
  flex-shrink: 0;
}
.fr-right {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.fr-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #101828;
}
.fr-ph {
  color: #98a2b3;
}
.fr-value {
  font-size: 28rpx;
  color: #101828;
  text-align: right;
  max-width: 380rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.fr-value.is-empty {
  color: #f79009;
}
.fr-unit {
  margin-left: 8rpx;
  font-size: 26rpx;
  color: #98a2b3;
}
.fr-arrow {
  width: 28rpx;
  height: 28rpx;
  margin-left: 8rpx;
  color: #98a2b3;
}
.fr-error {
  padding: 0 32rpx 16rpx;
  font-size: 24rpx;
  color: #ef4444;
}
