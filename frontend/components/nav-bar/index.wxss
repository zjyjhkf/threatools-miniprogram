.nav {
  background: #ffffff;
  width: 100%;
}
.nav-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
}
.nav-transparent {
  background: transparent;
}
.nav-inner {
  position: relative;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #101828;
  max-width: 400rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.nav-side {
  position: absolute;
  left: 16rpx;
  top: 0;
  height: 88rpx;
  min-width: 88rpx;
  display: flex;
  align-items: center;
}
.nav-side-right {
  left: auto;
  right: 16rpx;
  justify-content: flex-end;
  gap: 8rpx;
}
.nav-icon {
  width: 44rpx;
  height: 44rpx;
  margin: 0 22rpx;
  color: #101828;
}
.nav-dark .nav-title,
.nav-dark .nav-icon {
  color: #ffffff;
}

/* 右侧有操作：左图标区 / 中间标题 / 右侧按钮 + 胶囊占位，避免与微信胶囊重叠 */
.nav-lead {
  width: 88rpx;
  min-width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
}

.nav-lead .nav-icon {
  margin-left: 22rpx;
  margin-right: 0;
}

.nav-title-flex {
  flex: 1;
  min-width: 0;
  max-width: none;
  text-align: center;
}

.nav-tail {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  height: 88rpx;
}

.nav-capsule-gap {
  flex: none;
  height: 1rpx;
}
