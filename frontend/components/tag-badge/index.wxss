.tb {
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  line-height: 36rpx;
  display: inline-block;
}
.tb-hot {
  background: rgba(247, 144, 9, 0.12);
  color: #f79009;
}
.tb-new {
  background: #e8f8ef;
  color: #00a84a;
}
.tb-reviewing {
  background: #fef3c7;
  color: #b45309;
}
.tb-collected {
  background: rgba(18, 183, 106, 0.12);
  color: #12b76a;
}
