.sr {
  height: 120rpx;
  background: #ffffff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
}
.sr-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.sr-value {
  font-size: 40rpx;
  line-height: 44rpx;
  font-weight: 700;
  color: #101828;
  font-variant-numeric: tabular-nums;
}
.sr-label {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #98a2b3;
}
.sr-line {
  width: 1rpx;
  height: 48rpx;
  background: #ddf3e6;
}
