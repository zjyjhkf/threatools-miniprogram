.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: var(--bg-card, #ffffff);
  border-top: 1rpx solid var(--line-200, #ddf3e6);
  display: flex;
  box-shadow: 0 -4rpx 16rpx rgba(6, 42, 24, 0.04);
  z-index: 100;
}
.tabbar-item {
  flex: 1;
  height: 112rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--ink-400, #98a2b3);
}
.tabbar-item.is-on {
  color: var(--brand-600, #00a84a);
}
.tabbar-icon {
  width: 48rpx;
  height: 48rpx;
}
.tabbar-text {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 28rpx;
}
.tabbar-item.is-on .tabbar-text {
  font-weight: 600;
}
