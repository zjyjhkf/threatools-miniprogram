<view class="cpn">
  <view class="cpn-head">
    <view class="cpn-cats">
      <filter-chips options="{{categories}}" value="{{category}}" scroll bind:change="onCategoryChange" />
    </view>
    <view class="cpn-filter" bindtap="openFilter">
      <text class="cpn-filter-text">筛选</text>
      <view wx:if="{{filterCount}}" class="cpn-badge">{{filterCount}}</view>
    </view>
  </view>

  <scroll-view
    class="cpn-scroll"
    scroll-y
    scroll-top="{{scrollTop}}"
    lower-threshold="200"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onPullRefresh"
    bindscrolltolower="onLoadMore"
  >
    <view wx:if="{{status === 'loading'}}" class="cpn-body">
      <skeleton type="card" count="3" />
    </view>

    <empty-state
      wx:elif="{{status === 'error'}}"
      type="error"
      title="网络开小差了"
      desc="检查网络后重试"
      btnText="点击重试"
      bind:action="onRetry"
    />

    <empty-state
      wx:elif="{{status === 'empty'}}"
      type="empty"
      title="没有匹配的课程"
      desc="换个分类或减少筛选条件试试"
      btnText="重置筛选"
      bind:action="onRetry"
    />

    <view wx:else class="cpn-body">
      <view wx:if="{{main}}" class="cpn-main" bindtap="onMainTap">
        <course-card course="{{main}}" mode="hero" />
      </view>
      <view wx:for="{{list}}" wx:key="id" class="cpn-item">
        <course-card course="{{item}}" mode="row" bind:tap="onCourseTap" />
      </view>
      <loading-more status="{{moreStatus}}" bind:retry="onRetryMore" />
      <view class="cpn-bottom-space"></view>
    </view>
  </scroll-view>

  <picker-sheet
    show="{{filterShow}}"
    title="筛选"
    mode="custom"
    bind:confirm="applyFilter"
    bind:cancel="closeFilter"
  >
    <view class="fs">
      <text class="fs-label">难度</text>
      <filter-chips options="{{difficultyOptions}}" value="{{difficulty}}" multiple bind:change="onDifficulty" />
      <text class="fs-label">时长</text>
      <filter-chips options="{{durationOptions}}" value="{{duration}}" bind:change="onDuration" />
      <text class="fs-label">部位</text>
      <filter-chips options="{{partOptions}}" value="{{part}}" bind:change="onPart" />
      <view class="fs-actions">
        <view class="fs-reset" bindtap="resetFilter">重置</view>
        <view class="fs-confirm" bindtap="applyFilter">确定</view>
      </view>
    </view>
  </picker-sheet>
</view>
