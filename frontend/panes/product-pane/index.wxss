:host {
  display: block;
  height: 100%;
}
.pp {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--bg-page);
}
.pp-cats {
  height: 96rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}
.pp-scroll {
  flex: 1;
  height: 0;
}
.pp-body {
  padding: 8rpx 32rpx 0;
}
.pp-banner {
  position: relative;
  height: 300rpx;
  border-radius: var(--r-card);
  background: var(--bg-hero);
  padding: 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
}
.pp-banner-copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
}
.pp-banner-title {
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: 700;
  color: var(--ink-900);
}
.pp-banner-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--ink-500);
}
.pp-banner-action {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--brand-700);
}
.pp-banner-icon {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
}
.pp-banner-icon .icon {
  width: 72rpx;
  height: 72rpx;
  color: var(--brand-200);
}
.pp-grid {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.pp-item {
  width: 330rpx;
  margin-bottom: 24rpx;
}
.pp-note {
  padding: 16rpx 0 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: #98a2b3;
}
.pp-bottom-space {
  height: calc(112rpx + 40rpx + env(safe-area-inset-bottom));
}
