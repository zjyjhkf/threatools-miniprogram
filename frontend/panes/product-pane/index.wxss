:host {
  display: block;
  height: 100%;
}
.pp {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--bg-page);
}
.pp-cats {
  height: 96rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}
.pp-scroll {
  flex: 1;
  height: 0;
}
.pp-body {
  padding: 8rpx 32rpx 0;
}
/* 设备连接入口：替代原「专业康复装备」banner */
.pp-connect-wrap {
  padding: 8rpx 32rpx 0;
}
.pp-connect {
  position: relative;
  height: 284rpx;
  border-radius: var(--r-card);
  background: var(--bg-hero);
  border: 1rpx solid var(--line-200);
  padding: 36rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  overflow: hidden;
}
.pp-connect.is-on {
  background: var(--brand-100);
  border-color: var(--brand-200);
}
.pp-connect-copy {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  padding-right: 176rpx;
  display: flex;
  flex-direction: column;
}
.pp-connect-head {
  display: flex;
  align-items: center;
}
.pp-connect-title {
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: 700;
  color: var(--ink-900);
}
.pp-connect-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--ink-400);
  margin-left: 14rpx;
  flex: none;
}
.pp-connect-dot.is-on {
  background: var(--brand-600);
}
.pp-connect-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: var(--ink-500);
}
.pp-connect-name {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--brand-700);
}
.pp-connect-action {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--brand-700);
}
.pp-connect-icon {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
}
.pp-connect-icon .icon {
  width: 64rpx;
  height: 64rpx;
  color: var(--brand-200);
}
.pp-grid {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.pp-item {
  width: 330rpx;
  margin-bottom: 24rpx;
}
.pp-note {
  padding: 16rpx 0 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: #98a2b3;
}
.pp-bottom-space {
  height: calc(112rpx + 40rpx + env(safe-area-inset-bottom));
}
