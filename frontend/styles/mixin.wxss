/* 通用类（02 第 4 节 / 06 第 6 节），组件通过 styleIsolation: apply-shared 复用 */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg-page);
}
.page-pad {
  padding-left: var(--page-pad);
  padding-right: var(--page-pad);
  box-sizing: border-box;
}
.card {
  background: var(--bg-card);
  border-radius: var(--r-card);
  box-shadow: var(--sh-card);
}
.flex {
  display: flex;
}
.flex-center {
  display: flex;
  align-items: center;
}
.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flex-col {
  display: flex;
  flex-direction: column;
}
.flex-1 {
  flex: 1;
  min-width: 0;
}
.rel {
  position: relative;
}

.ellipsis-1 {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ellipsis-2,
.ellipsis-3 {
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  word-break: break-all;
}
.ellipsis-2 {
  -webkit-line-clamp: 2;
}
.ellipsis-3 {
  -webkit-line-clamp: 3;
}

.t-h1 {
  font-size: var(--fs-h1);
  line-height: 64rpx;
  font-weight: 700;
  color: var(--ink-900);
}
.t-h2 {
  font-size: var(--fs-h2);
  line-height: 56rpx;
  font-weight: 600;
  color: var(--ink-900);
}
.t-h3 {
  font-size: var(--fs-h3);
  line-height: 48rpx;
  font-weight: 600;
  color: var(--ink-900);
}
.t-body {
  font-size: var(--fs-body);
  line-height: 44rpx;
  color: var(--ink-700);
}
.t-s {
  font-size: var(--fs-body-s);
  line-height: 40rpx;
  color: var(--ink-500);
}
.t-caption {
  font-size: var(--fs-caption);
  line-height: 34rpx;
  color: var(--ink-400);
}
.t-muted {
  color: var(--ink-400);
}
.t-brand {
  color: var(--brand-600);
}
.t-ink {
  color: var(--ink-900);
}

.hairline {
  height: 1rpx;
  background: var(--line-200);
}
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
.tabbar-space {
  height: calc(112rpx + env(safe-area-inset-bottom));
}

/* 按钮：UI 2.1 主按钮为实心绿，不使用渐变 */
.btn {
  height: 88rpx;
  border-radius: var(--r-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  font-weight: 600;
  box-sizing: border-box;
}
.btn-primary {
  background: var(--brand-600);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(0, 168, 74, 0.2);
}
.btn-primary:active {
  background: var(--brand-700);
}
.btn-ghost {
  background: var(--bg-soft);
  color: var(--ink-700);
}
.btn-line {
  border: 2rpx solid var(--brand-600);
  color: var(--brand-700);
  background: #ffffff;
}
.btn-disabled {
  background: var(--bg-input);
  color: var(--ink-400);
  box-shadow: none;
}
.btn-sm {
  height: 64rpx;
  padding: 0 32rpx;
  font-size: var(--fs-body-s);
}
.press {
  opacity: 0.72;
}

/* 胶囊 / 标签 */
.chip {
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: var(--r-full);
  background: var(--bg-soft);
  color: var(--ink-500);
  font-size: var(--fs-body-s);
  display: inline-flex;
  align-items: center;
}
.chip-on {
  background: var(--brand-100);
  color: var(--brand-700);
  font-weight: 600;
}
.tag {
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: var(--r-s);
  font-size: var(--fs-micro);
  display: inline-flex;
  align-items: center;
}

/* 头像 */
.avatar {
  border-radius: var(--r-full);
  background: var(--brand-100);
  overflow: hidden;
  flex-shrink: 0;
}
.avatar-img {
  width: 100%;
  height: 100%;
}

/* 分割线单元格 */
.cell {
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-card);
  padding: 0 var(--page-pad);
  box-sizing: border-box;
}
.cell-line {
  margin-left: var(--page-pad);
  height: 1rpx;
  background: var(--line-200);
}
.group {
  background: var(--bg-card);
  border-radius: var(--r-card);
  margin: 0 var(--page-pad);
  overflow: hidden;
}
.section-title {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink-900);
}
