.pd {
  min-height: 100vh;
  background: #f1fef9;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.pd-swiper {
  width: 750rpx;
  height: 750rpx;
  background: #e8f8ef;
}
.pd-indicator {
  position: absolute;
  top: 660rpx;
  left: 32rpx;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(16, 24, 40, 0.5);
  color: #ffffff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  z-index: 5;
}
.pd-loading {
  padding: 32rpx;
}
.pd-head {
  background: #ffffff;
  padding: 32rpx;
}
.pd-name {
  font-size: 44rpx;
  line-height: 60rpx;
  font-weight: 700;
  color: #101828;
}
.pd-model {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #98a2b3;
}
.pd-tagline {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 44rpx;
  color: #344054;
}
.pd-tags {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.pd-price {
  margin-top: 16rpx;
  background: #ffffff;
  padding: 32rpx;
}
.pd-price-main {
  height: 88rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #cdebd9;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pd-price-text {
  font-size: 28rpx;
  color: #667085;
}
.pd-price-note {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #98a2b3;
  text-align: center;
}
.pd-block {
  margin-top: 16rpx;
  background: #ffffff;
  padding: 32rpx;
}
.pd-block-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pd-block-title {
  display: block;
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 600;
  color: #101828;
  margin-bottom: 16rpx;
}
.pd-block-head .pd-block-title {
  margin-bottom: 0;
}
.pd-block-tip {
  font-size: 22rpx;
  color: #98a2b3;
}
.pd-feature {
  display: flex;
  padding: 16rpx 0;
}
.pd-feature-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #e8f8ef;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}
.pd-feature-ic {
  width: 32rpx;
  height: 32rpx;
  color: #00a84a;
}
.pd-feature-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #101828;
}
.pd-feature-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #667085;
}
.pd-video {
  position: relative;
  margin-top: 8rpx;
}
.pd-video-play {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 104rpx;
  height: 104rpx;
  border-radius: 999rpx;
  background: rgba(16, 24, 40, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}
.pd-video-icon {
  width: 48rpx;
  height: 48rpx;
  color: #ffffff;
  margin-left: 4rpx;
}
.pd-video-player {
  width: 686rpx;
  height: 386rpx;
  border-radius: 16rpx;
}
.pd-spec {
  min-height: 88rpx;
  padding: 16rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f5fef9;
}
.pd-spec-label {
  width: 200rpx;
  font-size: 26rpx;
  color: #667085;
  flex-shrink: 0;
}
.pd-spec-value {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #101828;
}
.pd-suit {
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #f5fef9;
  color: #344054;
  font-size: 24rpx;
  display: flex;
  align-items: center;
}
.pd-related {
  height: 152rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #f5fef9;
}
.pd-related-name {
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #101828;
}
.pd-related-arrow {
  width: 28rpx;
  height: 28rpx;
  color: #98a2b3;
}
.pd-note {
  padding: 32rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: #98a2b3;
  text-align: center;
}
.pd-bottom-space {
  height: 40rpx;
}
