:host {
  display: block;
  height: 100%;
}
.cpn {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #f5f7fa;
}
.cpn-head {
  height: 96rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}
.cpn-cats {
  flex: 1;
  overflow: hidden;
}
.cpn-filter {
  position: relative;
  margin-left: 16rpx;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
}
.cpn-filter-text {
  font-size: 24rpx;
  color: #344054;
}
.cpn-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #ff6b35;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
  box-sizing: border-box;
}
.cpn-scroll {
  flex: 1;
  height: 0;
}
.cpn-body {
  padding: 8rpx 32rpx 0;
}
.cpn-main {
  margin-bottom: 24rpx;
}
.cpn-item {
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(16, 24, 40, 0.06);
}
.cpn-bottom-space {
  height: calc(98rpx + 40rpx + env(safe-area-inset-bottom));
}
.fs {
  padding: 8rpx 32rpx 32rpx;
}
.fs-label {
  display: block;
  margin: 24rpx 0 16rpx;
  font-size: 26rpx;
  color: #667085;
}
.fs-actions {
  margin-top: 40rpx;
  display: flex;
}
.fs-reset {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  background: #f2f4f7;
  color: #344054;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 28rpx;
}
.fs-confirm {
  flex: 2;
  height: 88rpx;
  border-radius: 999rpx;
  background: #2f6bff;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}
