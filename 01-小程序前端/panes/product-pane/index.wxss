:host {
  display: block;
  height: 100%;
}
.pp {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #f5f7fa;
}
.pp-cats {
  height: 96rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}
.pp-scroll {
  flex: 1;
  height: 0;
}
.pp-body {
  padding: 8rpx 32rpx 0;
}
.pp-banner {
  height: 300rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #2f6bff, #5b9bff);
  padding: 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.pp-banner-title {
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: 700;
  color: #ffffff;
}
.pp-banner-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}
.pp-banner-action {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #ffffff;
}
.pp-grid {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.pp-item {
  width: 330rpx;
  margin-bottom: 24rpx;
}
.pp-note {
  padding: 16rpx 0 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: #98a2b3;
}
.pp-bottom-space {
  height: calc(98rpx + 40rpx + env(safe-area-inset-bottom));
}
