.search {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.s-head {
  background: #ffffff;
  display: flex;
  align-items: center;
  padding-bottom: 12rpx;
}
.s-back {
  width: 44rpx;
  height: 44rpx;
  margin: 0 12rpx 0 24rpx;
  color: #101828;
}
.s-bar {
  flex: 1;
}
.block {
  margin: 24rpx 32rpx 0;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-sizing: border-box;
}
.block-head {
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.block-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #101828;
}
.block-icon {
  width: 40rpx;
  height: 40rpx;
  color: #98a2b3;
}
.block-more {
  font-size: 24rpx;
  color: #2f6bff;
}
.chips {
  display: flex;
  flex-wrap: wrap;
}
.chips .chip {
  margin: 0 16rpx 16rpx 0;
}
.hot {
  display: flex;
  flex-wrap: wrap;
}
.hot-item {
  width: 50%;
  height: 64rpx;
  display: flex;
  align-items: center;
}
.hot-index {
  width: 40rpx;
  font-size: 26rpx;
  color: #98a2b3;
}
.hot-index.is-top {
  color: #ff6b35;
  font-weight: 600;
}
.hot-name {
  flex: 1;
  font-size: 28rpx;
  color: #344054;
  padding-right: 16rpx;
}
.result-tabs {
  height: 88rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  box-sizing: border-box;
}
.result-tab {
  margin-right: 48rpx;
  font-size: 28rpx;
  color: #667085;
  position: relative;
  height: 88rpx;
  line-height: 88rpx;
}
.result-tab.is-on {
  color: #2f6bff;
  font-weight: 600;
}
.result-tab.is-on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #2f6bff;
}
.result-loading {
  padding: 64rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #98a2b3;
}
.result-empty {
  padding: 40rpx 0;
}
.result-item {
  margin-bottom: 16rpx;
  background: #ffffff;
  border-radius: 24rpx;
}
.result-post {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f2f4f7;
}
.result-post-text {
  font-size: 28rpx;
  line-height: 44rpx;
  color: #344054;
}
.result-post-author {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #98a2b3;
}
