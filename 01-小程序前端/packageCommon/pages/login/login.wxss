.login {
  min-height: 100vh;
  background: #2f6bff;
  position: relative;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.login-bg {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(160deg, #2f6bff 0%, #5b9bff 55%, #7ab0ff 100%);
}
.login-status,
.brand,
.visual,
.values,
.actions {
  position: relative;
  z-index: 1;
}
.brand {
  padding: 80rpx 32rpx 0;
  display: flex;
  flex-direction: column;
}
.brand-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.brand-logo-icon {
  width: 80rpx;
  height: 80rpx;
  color: #2f6bff;
}
.brand-name {
  margin-top: 40rpx;
  font-size: 48rpx;
  line-height: 64rpx;
  font-weight: 700;
  color: #ffffff;
}
.brand-slogan {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: rgba(255, 255, 255, 0.8);
}
.visual {
  margin: 48rpx 32rpx 0;
}
.values {
  margin-top: 48rpx;
  display: flex;
  justify-content: space-around;
  padding: 0 32rpx;
}
.value {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.value-icon {
  width: 48rpx;
  height: 48rpx;
  color: #ffffff;
}
.value-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}
.actions {
  margin-top: auto;
  padding: 0 32rpx calc(48rpx + env(safe-area-inset-bottom));
}
.login-btn {
  height: 96rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #2f6bff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.login-btn.is-loading {
  opacity: 0.7;
}
.agree {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
}
.agree-box {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.agree-box.is-on {
  background: #ffffff;
  border-color: #ffffff;
}
.agree-check {
  width: 24rpx;
  height: 24rpx;
  color: #2f6bff;
}
.agree-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}
.agree-link {
  font-size: 24rpx;
  color: #ffffff;
  text-decoration: underline;
}
