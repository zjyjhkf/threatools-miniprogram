.profile {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.p-loading {
  padding: 32rpx;
}
.group {
  margin: 24rpx 32rpx 0;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
}
.p-avatar-cell {
  height: 136rpx;
}
.p-avatar {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.p-avatar-ph {
  width: 48rpx;
  height: 48rpx;
  color: #2f6bff;
}
.p-value {
  font-size: 28rpx;
  color: #98a2b3;
  max-width: 420rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.p-copy {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #2f6bff;
}
.p-btn {
  margin: 40rpx 32rpx 0;
  height: 96rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #2f6bff, #5b9bff);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
