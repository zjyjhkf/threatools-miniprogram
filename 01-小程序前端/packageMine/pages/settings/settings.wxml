<view class="settings">
  <nav-bar back title="设置" bind:back="back" />

  <view wx:if="{{isLogin}}" class="st-group">
    <view class="cell">
      <text class="cell-label">当前账号</text>
      <view class="cell-right">
        <text class="st-value">{{nickname}}</text>
      </view>
    </view>
  </view>

  <view class="st-group">
    <view class="cell" data-type="user" bindtap="showAgreement">
      <text class="cell-label">用户协议</text>
      <view class="icon icon-arrow st-arrow"></view>
    </view>
    <view class="cell-line"></view>
    <view class="cell" data-type="privacy" bindtap="showAgreement">
      <text class="cell-label">隐私政策</text>
      <view class="icon icon-arrow st-arrow"></view>
    </view>
  </view>

  <view class="st-group">
    <view class="cell" bindtap="clearCache">
      <text class="cell-label">清除缓存</text>
      <view class="cell-right">
        <text class="st-value">{{cacheText}}</text>
        <view class="icon icon-arrow st-arrow"></view>
      </view>
    </view>
    <view class="cell-line"></view>
    <view class="cell" bindtap="about">
      <text class="cell-label">关于健衡</text>
      <view class="cell-right">
        <text class="st-value">{{version}}</text>
        <view class="icon icon-arrow st-arrow"></view>
      </view>
    </view>
  </view>

  <view wx:if="{{isLogin}}" class="st-logout" bindtap="logout">退出登录</view>

  <view class="st-footer">
    <text class="st-footer-text">健衡 v0.1.0</text>
    <text class="st-footer-text">© 2026 健衡健康科技</text>
    <text class="st-footer-text">本版本不含在线问诊与商品交易</text>
  </view>

  <toast show="{{toast.show}}" text="{{toast.text}}" />
  <dialog
    show="{{dialog.show}}"
    title="{{dialog.title}}"
    content="{{dialog.content}}"
    confirmText="{{dialog.confirmText}}"
    cancelText="{{dialog.cancelText}}"
    danger="{{dialog.danger}}"
    bind:confirm="onDialogConfirm"
    bind:cancel="closeDialog"
  />
</view>
