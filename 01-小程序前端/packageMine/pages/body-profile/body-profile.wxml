<view class="bp">
  <nav-bar back title="身体档案" bind:back="onBack">
    <view slot="right">
      <view class="bp-save {{saving ? 'is-disabled' : ''}}" bindtap="save">{{saving ? '保存中' : '保存'}}</view>
    </view>
  </nav-bar>

  <view wx:if="{{status === 'loading'}}" class="bp-loading">
    <skeleton type="detail" />
  </view>

  <empty-state wx:elif="{{status === 'error'}}" type="error" title="加载失败" btnText="点击重试" bind:action="onRetry" />

  <block wx:else>
    <view class="bp-group">
      <form-row
        label="身高"
        value="{{height}}"
        type="input"
        inputType="number"
        placeholder="请输入身高"
        unit="cm"
        arrow="{{false}}"
        error="{{errors.height}}"
        bind:input="onHeight"
      />
      <view class="cell-line"></view>
      <form-row
        label="体重"
        value="{{weight}}"
        type="input"
        inputType="digit"
        placeholder="请输入体重"
        unit="kg"
        arrow="{{false}}"
        error="{{errors.weight}}"
        bind:input="onWeight"
      />
    </view>

    <view class="bp-block">
      <view class="bp-head">
        <text class="bp-title">运动目标</text>
        <text class="bp-tip">1–3 个</text>
      </view>
      <filter-chips options="{{goalOptions}}" value="{{goals}}" multiple bind:change="onGoals" />
      <text wx:if="{{errors.goals}}" class="bp-error">{{errors.goals}}</text>
    </view>

    <view class="bp-group">
      <form-row label="每周运动频率" value="{{frequencyLabel}}" type="readonly" bind:tap="openFrequency" />
      <view class="cell-line"></view>
      <form-row label="运动水平" value="{{levelLabel}}" type="readonly" bind:tap="openLevel" />
    </view>

    <view class="bp-block">
      <view class="bp-head">
        <text class="bp-title">需要关注的部位</text>
        <text class="bp-tip">最多 5 个</text>
      </view>
      <filter-chips options="{{partOptions}}" value="{{focusParts}}" multiple bind:change="onParts" />
    </view>

    <view class="bp-block">
      <view class="bp-head">
        <text class="bp-title">既往损伤</text>
        <text class="bp-tip">{{injuries.length}}/100</text>
      </view>
      <textarea
        class="bp-textarea"
        value="{{injuries}}"
        placeholder="如无可留空"
        placeholder-class="bp-ph"
        maxlength="100"
        bindinput="onInjuries"
      />
      <text wx:if="{{errors.injuries}}" class="bp-error">{{errors.injuries}}</text>
    </view>

    <view class="bp-group">
      <form-row
        label="允许他人查看"
        value="{{allowPublic}}"
        type="switch"
        arrow="{{false}}"
        bind:change="onPublic"
      />
    </view>
    <view class="bp-note">身体档案仅用于生成训练建议，默认不对他人展示</view>
  </block>

  <picker-sheet
    show="{{frequencyShow}}"
    title="每周运动频率"
    options="{{frequencyOptions}}"
    value="{{frequency}}"
    bind:confirm="pickFrequency"
    bind:cancel="closeFrequency"
  />
  <picker-sheet
    show="{{levelShow}}"
    title="运动水平"
    options="{{levelOptions}}"
    value="{{level}}"
    bind:confirm="pickLevel"
    bind:cancel="closeLevel"
  />

  <toast show="{{toast.show}}" text="{{toast.text}}" />
  <dialog
    show="{{dialog.show}}"
    title="{{dialog.title}}"
    content="{{dialog.content}}"
    confirmText="{{dialog.confirmText}}"
    cancelText="{{dialog.cancelText}}"
    danger="{{dialog.danger}}"
    bind:confirm="onDialogConfirm"
    bind:cancel="closeDialog"
  />
</view>
