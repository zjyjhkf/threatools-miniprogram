.fc {
  display: flex;
  align-items: center;
}
.fc-scroll {
  white-space: nowrap;
  width: 100%;
}
.fc-item {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 24rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: #f2f4f7;
  color: #667085;
  font-size: 26rpx;
  flex-shrink: 0;
}
.fc-item.is-on {
  background: #e8f0ff;
  color: #2f6bff;
  font-weight: 600;
}
