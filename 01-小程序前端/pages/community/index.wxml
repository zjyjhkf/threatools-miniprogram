<view class="pg">
  <nav-bar title="{{titles[tab]}}" show-search bind:search="goSearch" />
  <offline-bar />
  <top-tabs tabs="{{tabs}}" current="{{tab}}" bind:change="onTabChange" />

  <view class="pg-body">
    <swiper
      class="pg-swiper"
      current="{{tab}}"
      duration="250"
      circular="{{false}}"
      bindchange="onSwiperChange"
    >
      <swiper-item>
        <community-pane
          id="pane0"
          active="{{tab === 0}}"
          bind:needlogin="onNeedLogin"
          bind:openpost="openPost"
          bind:openauthor="openAuthor"
          bind:opentopic="openTopic"
          bind:opentopics="openTopics"
          bind:tabswitch="onPaneTabSwitch"
        />
      </swiper-item>
      <swiper-item>
        <course-pane
          id="pane1"
          active="{{tab === 1}}"
          bind:opencourse="openCourse"
          bind:tabswitch="onPaneTabSwitch"
        />
      </swiper-item>
      <swiper-item>
        <product-pane
          id="pane2"
          active="{{tab === 2}}"
          bind:openproduct="openProduct"
          bind:tabswitch="onPaneTabSwitch"
        />
      </swiper-item>
    </swiper>
  </view>

  <fab-publish wx:if="{{tab === 0}}" bind:tap="goPublish" />

  <toast show="{{toast.show}}" text="{{toast.text}}" />
  <dialog
    show="{{dialog.show}}"
    title="{{dialog.title}}"
    content="{{dialog.content}}"
    confirmText="{{dialog.confirmText}}"
    cancelText="{{dialog.cancelText}}"
    danger="{{dialog.danger}}"
    bind:confirm="onDialogConfirm"
    bind:cancel="closeDialog"
  />
</view>
