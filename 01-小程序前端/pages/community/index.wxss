page {
  height: 100%;
  overflow: hidden;
}
.pg {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #f5f7fa;
}
/* 剩余空间交给定位容器，swiper 绝对铺满，规避各基础库对 swiper 高度的处理差异 */
.pg-body {
  flex: 1;
  min-height: 0;
  position: relative;
}
.pg-swiper {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}
