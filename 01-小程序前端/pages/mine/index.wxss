.mine {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 24rpx;
  box-sizing: border-box;
}
.header {
  position: relative;
  height: 440rpx;
  background: linear-gradient(135deg, #2f6bff, #5b9bff);
  padding: 0 32rpx;
  box-sizing: border-box;
}
.header-guest {
  height: 360rpx;
}
.header-avatar {
  position: absolute;
  left: 32rpx;
  top: 32rpx;
  width: 128rpx;
  height: 128rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
}
.header-avatar-ph {
  width: 64rpx;
  height: 64rpx;
  color: #2f6bff;
}
.header-name {
  position: absolute;
  left: 192rpx;
  top: 48rpx;
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: 700;
  color: #ffffff;
}
.header-id {
  position: absolute;
  left: 192rpx;
  top: 108rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: rgba(255, 255, 255, 0.8);
}
.header-bio {
  position: absolute;
  left: 32rpx;
  right: 160rpx;
  top: 336rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: rgba(255, 255, 255, 0.92);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.header-edit {
  position: absolute;
  right: 32rpx;
  top: 180rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
}
.complete-card {
  margin: -40rpx 32rpx 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(16, 24, 40, 0.06);
  padding: 32rpx;
  box-sizing: border-box;
  position: relative;
  z-index: 2;
}
.complete-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.complete-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #101828;
}
.complete-count {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff6b35;
}
.complete-bar {
  margin-top: 20rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #f2f4f7;
  overflow: hidden;
}
.complete-bar-inner {
  height: 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #2f6bff, #5b9bff);
}
.complete-foot {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.complete-desc {
  font-size: 24rpx;
  color: #667085;
}
.complete-action {
  font-size: 24rpx;
  color: #2f6bff;
}
.complete-done {
  margin: -40rpx 32rpx 24rpx;
  height: 88rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(16, 24, 40, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
}
.complete-done-text {
  font-size: 28rpx;
  color: #22c55e;
  font-weight: 600;
}
.complete-done-icon {
  width: 32rpx;
  height: 32rpx;
  margin-left: 12rpx;
  color: #22c55e;
}
.group {
  margin: 0 32rpx 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
}
.group-guest {
  opacity: 0.6;
}
.cell-label {
  font-size: 28rpx;
  color: #344054;
}
.cell-disabled {
  color: #98a2b3;
}
.cell-right {
  display: flex;
  align-items: center;
}
.cell-value {
  font-size: 26rpx;
  color: #98a2b3;
  margin-right: 8rpx;
}
.cell-arrow {
  width: 28rpx;
  height: 28rpx;
  color: #98a2b3;
}
.version {
  padding: 24rpx 0 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.version-text {
  font-size: 22rpx;
  line-height: 34rpx;
  color: #98a2b3;
}
.guest-btn {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  top: 224rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #2f6bff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.guest-note {
  margin: 24rpx 32rpx;
  font-size: 24rpx;
  line-height: 38rpx;
  color: #98a2b3;
  text-align: center;
}
