.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(98rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: #ffffff;
  display: flex;
  box-shadow: 0 -2rpx 12rpx rgba(16, 24, 40, 0.04);
  z-index: 100;
}
.tabbar-item {
  flex: 1;
  height: 98rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #98a2b3;
}
.tabbar-item.is-on {
  color: #2f6bff;
}
.tabbar-icon {
  width: 48rpx;
  height: 48rpx;
}
.tabbar-text {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 28rpx;
}
