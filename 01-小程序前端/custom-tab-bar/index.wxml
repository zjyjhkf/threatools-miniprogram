<view class="tabbar">
  <view
    class="tabbar-item {{selected === index ? 'is-on' : ''}}"
    wx:for="{{list}}"
    wx:key="text"
    data-index="{{index}}"
    bindtap="onTap"
  >
    <view class="icon icon-{{item.icon}} tabbar-icon"></view>
    <text class="tabbar-text">{{item.text}}</text>
  </view>
</view>
