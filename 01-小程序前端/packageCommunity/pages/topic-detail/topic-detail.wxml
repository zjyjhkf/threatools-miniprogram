<view class="td">
  <nav-bar
    back
    overlay
    theme="{{navSolid ? 'light' : 'dark'}}"
    transparent="{{!navSolid}}"
    title="{{navSolid ? '#' + topic.name : ''}}"
    bind:back="back"
  />

  <image-ph src="" w="750" h="480" radius="0" label="话题头图 750×480" />

  <view class="td-actions">
    <view class="td-info">
      <text class="td-name">#{{topic.name}}</text>
      <text class="td-desc">{{topic.description}}</text>
      <text class="td-stats">{{postText}} 条讨论 · {{userText}} 人参与</text>
    </view>
    <view class="td-btns">
      <view class="td-collect {{topic.collected ? 'is-on' : ''}}" bindtap="toggleCollect">
        {{topic.collected ? '已收藏' : '收藏'}}
      </view>
      <view class="td-join" bindtap="join">参与</view>
    </view>
  </view>

  <view class="td-sort">
    <view class="td-sort-item {{sort === 'hot' ? 'is-on' : ''}}" data-value="hot" bindtap="onSort">最热</view>
    <view class="td-sort-item {{sort === 'new' ? 'is-on' : ''}}" data-value="new" bindtap="onSort">最新</view>
  </view>

  <view wx:if="{{status === 'loading'}}" class="td-body">
    <skeleton type="card" count="2" />
  </view>

  <empty-state
    wx:elif="{{status === 'error'}}"
    type="error"
    title="网络开小差了"
    btnText="点击重试"
    bind:action="onRetry"
  />

  <empty-state wx:elif="{{status === 'notfound'}}" type="empty" title="话题不存在" desc="可能已被删除" btnText="返回" bind:action="back" />

  <empty-state wx:elif="{{status === 'empty'}}" type="empty" title="还没有人参与" desc="来发第一条动态吧" btnText="参与话题" bind:action="join" />

  <view wx:else class="td-body">
    <view wx:for="{{list}}" wx:key="id" class="td-item">
      <post-card
        post="{{item}}"
        bind:tap="openPost"
        bind:comment="openPost"
        bind:like="onLike"
        bind:collect="onCollect"
        bind:follow="onFollow"
        bind:author="onAuthor"
        bind:topic="onTopic"
      />
    </view>
    <loading-more status="{{moreStatus}}" bind:retry="onLoadMore" />
    <view class="td-bottom-space"></view>
  </view>

  <toast show="{{toast.show}}" text="{{toast.text}}" />
  <dialog
    show="{{dialog.show}}"
    title="{{dialog.title}}"
    content="{{dialog.content}}"
    confirmText="{{dialog.confirmText}}"
    cancelText="{{dialog.cancelText}}"
    danger="{{dialog.danger}}"
    bind:confirm="onDialogConfirm"
    bind:cancel="closeDialog"
  />
</view>
