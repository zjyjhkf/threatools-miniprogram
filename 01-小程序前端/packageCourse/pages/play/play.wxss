.play {
  min-height: 100vh;
  background: #0b0f16;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.play-top {
  display: flex;
  align-items: center;
  background: #000000;
}
.play-back {
  width: 44rpx;
  height: 44rpx;
  margin: 22rpx 16rpx 22rpx 24rpx;
  color: #ffffff;
}
.play-title {
  flex: 1;
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 600;
}
.play-full {
  padding: 22rpx 24rpx;
}
.play-full-icon {
  width: 44rpx;
  height: 44rpx;
  color: #ffffff;
}
.player {
  position: relative;
  width: 750rpx;
  height: 422rpx;
  background: #000000;
}
.video {
  width: 100%;
  height: 100%;
}
.player-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.player-play {
  width: 112rpx;
  height: 112rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
}
.player-play-icon {
  width: 56rpx;
  height: 56rpx;
  color: #ffffff;
  margin-left: 6rpx;
}
.player-error {
  padding: 20rpx 32rpx;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.6);
}
.player-error-text {
  font-size: 26rpx;
  color: #ffffff;
}
.player-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 64rpx;
  padding: 0 24rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.7));
  display: flex;
  align-items: center;
}
.player-time {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  font-variant-numeric: tabular-nums;
}
.player-slider {
  flex: 1;
  margin: 0 12rpx;
}
.player-fullscreen {
  padding: 8rpx;
}
.player-fullscreen-icon {
  width: 32rpx;
  height: 32rpx;
  color: rgba(255, 255, 255, 0.9);
}
.play-info {
  background: #141821;
  padding: 28rpx 32rpx;
}
.play-chapter-idx {
  display: block;
  font-size: 22rpx;
  color: #7c8798;
}
.play-chapter-title {
  display: block;
  margin-top: 8rpx;
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 600;
  color: #ffffff;
}
.play-coach {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #98a2b3;
}
.play-list {
  margin-top: 16rpx;
  background: #141821;
  padding: 0 32rpx 16rpx;
}
.play-list-head {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.play-list-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}
.play-auto {
  display: flex;
  align-items: center;
}
.play-auto-text {
  font-size: 22rpx;
  color: #7c8798;
  margin-right: 12rpx;
}
.play-auto-switch {
  width: 56rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: #2b3444;
  padding: 4rpx;
  box-sizing: border-box;
}
.play-auto-switch.is-on {
  background: #2f6bff;
}
.play-auto-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  transition: transform 0.2s;
}
.play-auto-switch.is-on .play-auto-dot {
  transform: translateX(24rpx);
}
.chapter-list {
  max-height: 480rpx;
}
.chapter {
  height: 104rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #1f2632;
}
.chapter-active {
  background: rgba(47, 107, 255, 0.12);
}
.chapter-idx {
  width: 48rpx;
  font-size: 24rpx;
  color: #7c8798;
}
.chapter-title {
  display: block;
  font-size: 28rpx;
  color: #e6ebf2;
}
.chapter-active .chapter-title {
  color: #5b9bff;
  font-weight: 600;
}
.chapter-dur {
  font-size: 22rpx;
  color: #7c8798;
}
.chapter-play {
  width: 32rpx;
  height: 32rpx;
  color: #7c8798;
}
.chapter-playing-text {
  font-size: 22rpx;
  color: #5b9bff;
}
.play-tools {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding: 0 48rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: #000000;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 100;
}
.play-tool {
  padding: 20rpx 24rpx;
}
.play-tool-text {
  font-size: 26rpx;
  color: #e6ebf2;
}
.play-tool-main {
  width: 88rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}
.play-tool-icon {
  width: 40rpx;
  height: 40rpx;
  color: #ffffff;
}
