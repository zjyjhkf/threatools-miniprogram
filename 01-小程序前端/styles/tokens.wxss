/* 设计令牌（02 第 2–4 节实测值） */
page {
  --brand-600: #2F6BFF;
  --brand-700: #1E4FD8;
  --brand-100: #E8F0FF;
  --brand-grad: linear-gradient(135deg, #2F6BFF, #5B9BFF);
  --accent-600: #FF6B35;
  --success-600: #22C55E;
  --warning-600: #F59E0B;
  --danger-600: #EF4444;
  --ink-900: #101828;
  --ink-700: #344054;
  --ink-500: #667085;
  --ink-400: #98A2B3;
  --line-200: #E4E7EC;
  --bg-page: #F5F7FA;
  --bg-card: #FFFFFF;
  --bg-input: #F2F4F7;
  --bg-skeleton: #EEF0F3;
  --bg-mask: rgba(16, 24, 40, 0.45);
  --bg-warn: #FEF3C7;
  --ink-warn: #B45309;
  --dark-1: #000000;
  --dark-2: #0B0F16;
  --dark-3: #141821;
  --dark-4: #0B1B33;

  --fs-h1: 48rpx;
  --fs-h2: 40rpx;
  --fs-h3: 34rpx;
  --fs-body: 28rpx;
  --fs-body-s: 26rpx;
  --fs-caption: 24rpx;
  --fs-micro: 20rpx;

  --r-s: 16rpx;
  --r-m: 24rpx;
  --r-l: 32rpx;
  --r-full: 999rpx;
  --sh-card: 0 8rpx 24rpx rgba(16, 24, 40, 0.06);
  --sh-float: 0 12rpx 32rpx rgba(16, 24, 40, 0.12);
  --page-pad: 32rpx;
  --card-gap: 24rpx;
  --block-gap: 40rpx;

  background: var(--bg-page);
  color: var(--ink-900);
  font-size: var(--fs-body);
  line-height: 44rpx;
  font-family: -apple-system, "PingFang SC", "HarmonyOS Sans", "Noto Sans SC", sans-serif;
  -webkit-font-smoothing: antialiased;
}

.tabnum {
  font-variant-numeric: tabular-nums;
}
